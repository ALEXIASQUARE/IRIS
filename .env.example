# Base de données (MariaDB)
DATABASE_URL=mysql://iris:iris_dev_password@localhost:3306/iris

# Redis (cache / queues futures -- non requis pour le MVP tel que concu, Addendum S2.4)
REDIS_URL=redis://localhost:6379

# Authentification
JWT_ACCESS_SECRET=change_me_in_production
JWT_REFRESH_SECRET=change_me_in_production_too

# Fournisseur OTP (Addendum S5.3) -- mock par defaut en dev
OTP_PROVIDER=mock

# Paiements -- ne jamais mettre de vraies cles ici, cf. S18 du Cahier des charges.
# MTN MoMo : compte developpeur sur momodeveloper.mtn.com, produit
# "Collections" (pas "Collection Widget", qui est une API differente).
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_API_SECRET=

# Stockage objet (S3-compatible)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Divers
PORT=3000
NODE_ENV=development
